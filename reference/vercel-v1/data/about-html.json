  {
   "tag": "p",
   "text": "ABOUT FITZGERALD CLASSICS",
   "region": "main",
   "y": 160,
   "x": 130,
   "font": "Inter, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
   "size": "17.92px",
   "weight": "800",
   "color": "rgb(234, 223, 207)",
